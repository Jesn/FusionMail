# FusionMail Docker Compose 环境变量配置示例
# 复制此文件为 .env 并根据实际情况修改配置

# ============================================
# 数据库配置
# ============================================
DB_PASSWORD=fusionmail_password

# ============================================
# Redis 配置
# ============================================
REDIS_PASSWORD=fusionmail_redis_password

# ============================================
# 安全配置（生产环境必须修改）
# ============================================

# JWT 密钥（至少 32 字符，生产环境必须修改）
# 生成方法: openssl rand -base64 32
JWT_SECRET=change-this-secret-in-production

# 加密密钥（必须是 32 字节，生产环境必须修改）
# 生成方法: openssl rand -base64 32 | head -c 32
ENCRYPTION_KEY=change-this-32-byte-key-prod

# 管理员初始密码（可选，建议在生产环境设置）
# 如果不设置，系统会自动生成随机密码并保存到容器内 /app/passwd 文件
# 生产环境建议设置强密码（至少 8 个字符，包含大小写字母、数字和特殊字符）
# ADMIN_PASSWORD=your-strong-password-here

# 是否保存密码到文件（可选）
# 开发环境：默认 true，自动保存到 passwd 文件
# 生产环境：默认 false，不保存密码文件（推荐）
# 如果设置了 ADMIN_PASSWORD，建议设置为 false
SAVE_PASSWORD_FILE=false

# ============================================
# 应用配置
# ============================================

# 应用端口（默认 3333）
APP_PORT=3333

# CORS 允许的源（逗号分隔）
CORS_ORIGINS=http://localhost:3333

# ============================================
# 速率限制配置
# ============================================

# 是否启用速率限制
RATE_LIMIT_ENABLED=true

# 站点级别速率限制（每分钟请求数）
RATE_LIMIT_SITE=100

# 公共 API 速率限制（每分钟请求数）
RATE_LIMIT_PUBLIC=200

# ============================================
# Swagger API 文档配置
# ============================================

# 是否启用 Swagger API 文档（生产环境建议关闭）
SWAGGER_ENABLED=false
