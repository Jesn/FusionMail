# WebAPI 集成测试配置示例
# 复制此文件为 .webapi-test-config 并填入真实值
# 然后使用 source .webapi-test-config 加载环境变量

# Cloudflare Temp Email Admin 模式
# 示例：https://temp-email.100420.xyz
export CLOUDFLARE_BASE_URL=https://your-temp-email-domain.com
export CLOUDFLARE_ADMIN_PASSWORD=your-admin-password

# 数据库连接（使用 docker-compose 启动的本地数据库）
# 默认配置：docker-compose -f docker-compose.dev.yml up -d
export DATABASE_URL=postgresql://fusionmail:fusionmail@localhost:5432/fusionmail?sslmode=disable

# 运行集成测试命令：
# cd backend
# source tests/integration/.webapi-test-config
# go test -tags=integration ./tests/integration/... -v
