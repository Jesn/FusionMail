# FusionMail 后端环境变量配置
# 复制此文件为 .env 并根据实际情况修改配置值

# ============================================
# 数据库配置
# ============================================
# 开发环境使用本地 Docker（docker-compose.dev.yml）
DB_HOST=localhost
DB_PORT=5432
DB_USER=fusionmail
DB_PASSWORD=fusionmail_dev_password
DB_NAME=fusionmail
DB_SSLMODE=disable

# ============================================
# Redis 配置
# ============================================
# 开发环境使用本地 Docker（docker-compose.dev.yml）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=fusionmail_redis_password
REDIS_DB=0

# ============================================
# 服务器配置
# ============================================
SERVER_HOST=0.0.0.0
SERVER_PORT=3333

# CORS 跨域配置（逗号分隔多个域名）
CORS_ALLOWED_ORIGINS=http://localhost:3100,http://localhost:4444

# ============================================
# 安全配置
# ============================================

# JWT 配置
JWT_SECRET=your-jwt-secret-key-at-least-32-characters
JWT_EXPIRY_HOURS=24

# 加密密钥（必须是 32 字节）
ENCRYPTION_KEY=your-32-byte-encryption-key-here

# ============================================
# 存储配置
# ============================================
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./data/attachments
STORAGE_BASE_URL=

# ============================================
# 速率限制配置
# ============================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_SITE_REQUESTS_PER_MINUTE=100
RATE_LIMIT_PUBLIC_REQUESTS_PER_MINUTE=200

# ============================================
# Swagger API 文档配置
# ============================================
# 是否启用 Swagger API 文档（默认关闭，生产环境建议关闭）
SWAGGER_ENABLED=false

# ============================================
# 可选配置（根据需要启用）
# ============================================

# OAuth2 客户端配置（可选，用于从环境变量同步到数据库）
# GMAIL_CLIENT_ID=your-gmail-client-id
# GMAIL_CLIENT_SECRET=your-gmail-client-secret
# MICROSOFT_CLIENT_ID=your-microsoft-client-id
# MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret

# Gin 运行模式（可选，默认 release）
# GIN_MODE=debug

# 静态文件路径（可选，默认 ../frontend/dist）
# STATIC_PATH=../frontend/dist

# ============================================
# 重要说明
# ============================================
# 1. OAuth2 配置已迁移到数据库，请通过管理界面或 API 配置
# 2. UI 配置（主题、语言等）已迁移到数据库
# 3. 功能开关配置已迁移到数据库
# 4. 同步配置、日志配置等已迁移到数据库
# 5. 云存储（AWS S3、阿里云 OSS）功能尚未实现

# ============================================
# 安全建议
# ============================================
# 1. 生产环境必须设置强密码的 JWT_SECRET（至少 32 字符）
# 2. 生产环境必须设置 32 字节的 ENCRYPTION_KEY
# 3. 定期更换数据库密码和 Redis 密码
# 4. 不要将 .env 文件提交到 Git

# ============================================
# 生成强密钥的方法
# ============================================
# JWT_SECRET:
#   openssl rand -base64 32
#
# ENCRYPTION_KEY (必须是 32 字节):
#   openssl rand -base64 32 | cut -c1-32