# FusionMail 后端环境变量配置
# 复制此文件为 .env 并根据实际情况修改配置值

# ==========================================
# 必需配置 - 系统运行必需
# ==========================================

# 数据库配置
DB_HOST=localhost
DB_PORT=5432
DB_USER=fusionmail
DB_PASSWORD=your_database_password
DB_NAME=fusionmail
DB_SSLMODE=disable

# 服务器配置
SERVER_HOST=0.0.0.0
SERVER_PORT=3333

# CORS 跨域配置（逗号分隔多个域名）
CORS_ALLOWED_ORIGINS=http://localhost:3100,http://localhost:4444

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=your_redis_password  # 如果Redis需要密码认证，请取消注释
REDIS_DB=0

# JWT 配置
# JWT_SECRET=your-jwt-secret-key-at-least-32-characters  # 生产环境必需，请使用强密钥
JWT_EXPIRY=24h

# 管理员配置
ADMIN_PASSWORD_HASH=$2a$10$QcoYuPkcC0LOU7BTl44OTeNDpHLYUwxI3pDzUmCpxHwevsg5UU6ci

# 加密配置 (必须是32字节长度)
# ENCRYPTION_KEY=your-32-byte-encryption-key-here  # 生产环境必需，用于数据加密

# 主密码配置
MASTER_PASSWORD=admin123

# 存储配置
STORAGE_TYPE=local
STORAGE_PATH=./data/attachments

# 速率限制配置
RATE_LIMIT_ENABLED=true
RATE_LIMIT_SITE_REQUESTS_PER_MINUTE=100
RATE_LIMIT_PUBLIC_REQUESTS_PER_MINUTE=200

# ==========================================
# 可选配置 - 根据需要启用
# ==========================================

# 代理配置（可选，用于跨境访问）
# HTTP_PROXY=http://proxy.example.com:3128
# HTTPS_PROXY=https://proxy.example.com:3128
# NO_PROXY=localhost,127.0.0.1

# ==========================================
# 重要说明
# ==========================================
# 1. OAuth2 配置已迁移到数据库，请通过管理界面配置
# 2. UI 配置（主题、语言等）已迁移到数据库
# 3. 功能开关配置已迁移到数据库
# 4. 云存储（AWS S3、阿里云 OSS）功能尚未实现
# 5. SMTP 功能尚未实现
# 6. 日志级别使用默认值 info
# 7. 同步配置使用系统默认值

# ==========================================
# 安全建议
# ==========================================
# 1. 生产环境必需设置强密码的 JWT_SECRET
# 2. 生产环境必需设置 32 字节的 ENCRYPTION_KEY
# 3. 定期更换数据库密码和 Redis 密码
# 4. 使用环境变量而非硬编码敏感信息