# FusionMail 后端环境变量配置示例
# 复制此文件为 .env 并填入实际配置值

# 数据库配置
DB_HOST=localhost
DB_PORT=5432
DB_USER=fusionmail
DB_PASSWORD=your_database_password
DB_NAME=fusionmail
DB_SSLMODE=disable

# 服务器配置
SERVER_HOST=0.0.0.0
SERVER_PORT=3333

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
REDIS_DB=0

# JWT 配置
JWT_SECRET=your-jwt-secret-key-at-least-32-characters
JWT_EXPIRY=24h

# 加密配置 (必须是32字节长度)
ENCRYPTION_KEY=your-32-byte-encryption-key-here

# 存储配置
STORAGE_TYPE=local
STORAGE_PATH=./data/attachments

# 同步配置
SYNC_WORKER_COUNT=5
SYNC_DEFAULT_INTERVAL=5

# 日志配置
LOG_LEVEL=info
LOG_FORMAT=json

# Gmail API 配置
# 1. 访问 https://console.developers.google.com/
# 2. 创建项目并启用 Gmail API
# 3. 创建 OAuth 2.0 客户端 ID
# 4. 添加重定向 URI: http://localhost:3333/api/v1/auth/google/callback
GMAIL_CLIENT_ID=your_gmail_client_id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your_gmail_client_secret
GMAIL_REDIRECT_URI=http://localhost:3333/api/v1/auth/google/callback

# Microsoft Graph API 配置 (Outlook/Hotmail)
# 1. 访问 https://portal.azure.com/
# 2. 注册应用程序
# 3. 配置 API 权限: Mail.Read, Mail.ReadWrite, offline_access
# 4. 添加重定向 URI: http://localhost:3333/api/v1/auth/microsoft/callback
MICROSOFT_CLIENT_ID=your_microsoft_client_id
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret
MICROSOFT_REDIRECT_URI=http://localhost:3333/api/v1/auth/microsoft/callback

# OAuth2 通用配置
OAUTH_STATE_SECRET=your-oauth-state-secret-key

# 代理配置（可选，用于跨境访问）
# HTTP_PROXY=http://proxy.example.com:3128
# HTTPS_PROXY=https://proxy.example.com:3128
# NO_PROXY=localhost,127.0.0.1

# 速率限制配置
RATE_LIMIT_ENABLED=true
RATE_LIMIT_SITE_REQUESTS_PER_MINUTE=100
RATE_LIMIT_PUBLIC_REQUESTS_PER_MINUTE=200

# Webhook 配置
WEBHOOK_TIMEOUT_SECONDS=30
WEBHOOK_MAX_RETRIES=3