# ============================================
# FusionMail 生产环境配置示例
# ============================================
# 使用方法：
#   1. 复制此文件为 .env.prod
#   2. 修改所有必填项（标记为 REQUIRED）
#   3. 运行: docker-compose -f docker-compose.prod.yml --env-file .env.prod up -d
# ============================================

# ============================================
# 数据库配置（外部 PostgreSQL）
# ============================================
DB_HOST=192.168.2.200
DB_PORT=5432
DB_NAME=fusionmail
DB_USER=postgres
DB_PASSWORD=your-strong-db-password-here  # REQUIRED: 必须修改
DB_SSLMODE=disable

# ============================================
# Redis 配置（外部 Redis）
# ============================================
REDIS_HOST=192.168.2.200
REDIS_PORT=6379
REDIS_PASSWORD=  # 如果 Redis 有密码，请填写

# ============================================
# 安全配置（必须修改）
# ============================================

# JWT 密钥（至少 32 字符）
# 生成命令: openssl rand -base64 32
JWT_SECRET=your-jwt-secret-at-least-32-chars-long  # REQUIRED: 必须修改
JWT_EXPIRY_HOURS=24

# 加密密钥（必须是 32 字节，设置后不可更改！）
# 生成命令: openssl rand -base64 32 | cut -c1-32
# ⚠️ 警告：此密钥用于加密敏感数据，一旦设置不可更改，否则已加密数据无法解密
ENCRYPTION_KEY=your-32-byte-encryption-key-here  # REQUIRED: 必须修改

# 管理员初始密码（可选）
# 如果不设置，系统会自动生成随机密码并显示在日志中
# 建议：生产环境设置一个强密码，首次登录后立即修改
ADMIN_PASSWORD=

# 是否保存密码到文件（生产环境建议设置为 false）
SAVE_PASSWORD_FILE=false

# ============================================
# 服务器配置
# ============================================
SERVER_HOST=0.0.0.0
SERVER_PORT=3333

# ============================================
# 存储配置
# ============================================
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=/data/attachments

# 如果使用 S3 存储（可选）
# STORAGE_TYPE=s3
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# S3_BUCKET=fusionmail-attachments

# ============================================
# 速率限制配置
# ============================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_SITE=100          # 站点默认限速（每分钟请求数）
RATE_LIMIT_PUBLIC=200        # 公共 API 限速（每分钟请求数）

# ============================================
# Swagger API 文档
# ============================================
# 生产环境建议关闭，开发/测试环境可以开启
SWAGGER_ENABLED=false

# ============================================
# CORS 配置
# ============================================
# 允许的跨域来源（逗号分隔）
# 示例：http://192.168.2.200:3333,https://mail.example.com
CORS_ORIGINS=http://192.168.2.200:3333

# ============================================
# Cookie 安全配置
# ============================================
# 如果使用 Nginx 反向代理 + HTTPS，设置为 true
# 纯 HTTP 环境设置为 false
COOKIE_SECURE=false

# ============================================
# 部署端口
# ============================================
# 外部访问端口（映射到容器的 3333 端口）
APP_PORT=3333

# ============================================
# 生成密钥的命令参考
# ============================================
# JWT_SECRET:
#   openssl rand -base64 32
#
# ENCRYPTION_KEY (必须 32 字节):
#   openssl rand -base64 32 | cut -c1-32
#
# DB_PASSWORD:
#   openssl rand -base64 24
#
# 示例生成脚本：
#   echo "JWT_SECRET=$(openssl rand -base64 32)"
#   echo "ENCRYPTION_KEY=$(openssl rand -base64 32 | cut -c1-32)"
#   echo "DB_PASSWORD=$(openssl rand -base64 24)"
