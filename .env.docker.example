# ============================================
# FusionMail Docker 部署环境变量配置
# ============================================
# 使用方法:
#   1. 复制此文件为 .env: cp .env.docker.example .env
#   2. 修改下面的配置值（特别是密码和密钥）
#   3. 运行: docker-compose up -d
# ============================================

# ============================================
# 数据库密码（必须修改）
# ============================================
# 生成方法: openssl rand -base64 16
DB_PASSWORD=your_secure_database_password

# ============================================
# Redis 密码（必须修改）
# ============================================
# 生成方法: openssl rand -base64 16
REDIS_PASSWORD=your_secure_redis_password

# ============================================
# JWT 密钥（必须修改，至少 32 字符）
# ============================================
# 生成方法: openssl rand -base64 32
JWT_SECRET=your-jwt-secret-key-at-least-32-characters-long

# ============================================
# 加密密钥（必须修改，必须是 32 字节）
# ============================================
# 生成方法: openssl rand -base64 32 | cut -c1-32
ENCRYPTION_KEY=your-32-byte-encryption-key-here

# ============================================
# 应用端口（可选，默认 3333）
# ============================================
APP_PORT=3333

# ============================================
# CORS 配置（可选）
# ============================================
# 如果前端部署在不同域名，需要配置
CORS_ORIGINS=http://localhost:3333

# ============================================
# 速率限制（可选）
# ============================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_SITE=100
RATE_LIMIT_PUBLIC=200

# ============================================
# Swagger API 文档（可选，生产环境建议关闭）
# ============================================
SWAGGER_ENABLED=false

# ============================================
# 安全提示
# ============================================
# 1. 生产环境必须修改所有默认密码和密钥
# 2. 不要将此文件提交到 Git（已在 .gitignore 中）
# 3. 定期更换密码和密钥
# 4. 使用 HTTPS 部署（通过 Nginx 反向代理）
