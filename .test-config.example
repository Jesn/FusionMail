# FusionMail 测试配置示例
# 复制此文件为 .test-config 并填入真实的测试账号信息
# 注意：.test-config 已在 .gitignore 中，不会被提交到 Git

# 139 邮箱测试账号
TEST_139_EMAIL="your_phone@139.com"
TEST_139_PASSWORD="your_authorization_code"

